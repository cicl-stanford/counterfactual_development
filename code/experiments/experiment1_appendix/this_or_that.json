    "frames": {
        "video-config": {
            "kind": "exp-video-config",
            "troubleshootingIntro": "If you're having any trouble or would like us to walk you through setup, please email our researcher Siying Zhang at syzhang6@stanford.edu."
        },
        "video-consent": {
            "gdpr": false,
            "kind": "exp-lookit-video-consent",
            "template": "consent_002",
            "PIName": "Hyowon Gweon, Tobias Gerstenberg",
            "PIContact": "Hyowon Gweon(contact:sociallearninglab@stanford.edu), Tobias Gerstenberg(gerstenberg@stanford.edu)",
            "institution": "Stanford University",
            "purpose": "We want to know whether children have a preference for any of the objects in each scenario.",
            "procedures": "In this game, your child will be introduced to our main character -- Granny. As Granny tidies up her house, she stumbles upon various items. During the game, your child will be presented with pairs of different objects and asked to express their preference by choosing which one they like or which one Granny favors.",
            "payment": "There are no costs to participating. There are also no known risks associated with this game beyond those of everyday life. Although this game will not benefit your child directly, it will add to our understanding of how children think in general. After you finish the game, we will email you a $5 Amazon.com gift card within a week. To be eligible for the gift card your child must be in the age range for this game, you need to submit a valid consent statement and your child needs to be visible during game. But we will send a gift card even if you do not finish the whole game or we are not able to use your child's data. There are no other direct benefits to you or your child from participating, but we hope you will enjoy the experience.",
            "datause": "We use a secure, web-based data library called Box to store your data. All data is private so that only members of the research team can access it. A research assistant will watch your video and mark down your child's answer to the question at the end of the story, and as well as other information such as interactions between you and your child during the story. You will choose a privacy level that says whether researchers can share the videos more broadly, for instance to teach students. Whether to share data is completely up to you!",
            "research_rights_statement": "This research has been reviewed and approved by an Institutional Review Board (“IRB”), a group of people who oversee research involving humans as participants. Information to help you understand research is on-line at https://templatestudiesinstitute.edu/irb. You may talk to a IRB staff member at (123) 456-7890 or IRBAdmin@tsi.edu for any of the following: 1) Your questions, concerns, or complaints are not being answered by the research team; 2) you cannot reach the research team; 3) you want to talk to someone besides the research team; 4) you have questions about your rights as a research subject; 5) you want to get information or provide input about this research."
        },
        "exit-survey": {
            "kind": "exp-lookit-exit-survey",
            "debriefing": {
                "text": "This study is a continuation of our previous research. In the earlier study, we presented scenarios where two of Granny's friends offered assistance in various situations. In each scenario, two friends helped Granny catch stuff that she accidentally dropped off. We then asked children to decide which friend Granny would give her thank-you sticker to. Our goal was to understand how children assess the helpfulness of others in different situations. \n For instance, in one scenario where Granny dropped of a phone and a rubber ducky, if nobody helped Granny catch the phone, it would fall into a fish tank and get wet. However, if no one helped Granny catch the rubber ducky, it would be fine. We believe that children who can imagine these different outcomes will recognize that it's worse for the phone to fall in the water, and they'll thank the friend who caught it. Our hypothesis is that children's judgments are influenced by the extent to which each friend prevented negative outcomes.\nThis current study was designed to investigate whether children choose the object they generally like more rather than considering the potential consequences of each object falling in the previous study. Although children’s answers can vary, there aren’t any “right” or “wrong” answers to the questions. We are just interested in looking at the average responses from children and we won’t take any specific answers as “good” or “bad”.  \n\n If you are interested in learning more about this, please see the following experimental paper as <a href='https://cicl.stanford.edu/papers/bridgers2020granny.pdf' target='_blank' rel='noopener'>here</a>. \n\n Thank you again for your participation! Gift cards will be sent within one week of game completion. Please note that we only offer Amazon.com gift card at this time, thanks for your understanding!",
                "title": "Thank you!"
            }
        },
